<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><%- include('../partials/head', {pageTitle: 'المنتجات'}) %></head>
<body>
  <%- include('../partials/header') %>
  <div class="container dash-layout">
    <%- include('../partials/admin-nav') %>
    <div>
      <h1 style="font-size:22px">إدارة المنتجات</h1>
      <div class="panel">
        <table>
          <tr><th>المنتج</th><th>المتجر</th><th>السعر</th><th>الحالة</th><th>مميز</th></tr>
          <% products.forEach(p => { %>
            <tr>
              <td><a href="/product/<%= p.id %>"><%= p.title %></a></td>
              <td><%= p.storeName %></td>
              <td><%= p.price ? p.price.toLocaleString('ar-EG') : '—' %></td>
              <td>
                <form method="POST" action="/admin/products/<%= p.id %>/status" style="display:flex;gap:6px">
                  <select name="status" onchange="this.form.submit()">
                    <option value="active" <%= p.status==='active'?'selected':'' %>>نشط</option>
                    <option value="hidden" <%= p.status==='hidden'?'selected':'' %>>مخفي</option>
                    <option value="sold" <%= p.status==='sold'?'selected':'' %>>تم البيع</option>
                  </select>
                </form>
              </td>
              <td>
                <form method="POST" action="/admin/products/<%= p.id %>/status">
                  <input type="hidden" name="status" value="<%= p.status %>">
                  <input type="checkbox" name="featured" onchange="this.form.submit()" <%= p.featured?'checked':'' %>>
                </form>
              </td>
            </tr>
          <% }) %>
        </table>
        <% if (!products.length) { %><p class="empty">لا توجد منتجات بعد.</p><% } %>
      </div>
    </div>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>
