<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><%- include('partials/head', {pageTitle: 'إنشاء حساب'}) %></head>
<body>
  <%- include('partials/header') %>
  <div class="form-page">
    <h1>إنشاء حساب جديد</h1>
    <% if (error) { %><div class="error-msg"><%= error %></div><% } %>
    <form method="POST" action="/register">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field"><label>الاسم الكامل</label><input type="text" name="name" required></div>
      <div class="field"><label>البريد الإلكتروني</label><input type="email" name="email" required></div>
      <div class="field"><label>رقم الهاتف</label><input type="text" name="phone"></div>
      <div class="field"><label>كلمة المرور</label><input type="password" name="password" required></div>
      <div class="field">
        <label>نوع الحساب</label>
        <div class="radio-group">
          <label><input type="radio" name="role" value="buyer" checked> مشتري</label>
          <label><input type="radio" name="role" value="vendor"> عارض (صاحب متجر)</label>
        </div>
      </div>
      <button class="btn btn-gold" style="width:100%">إنشاء الحساب</button>
    </form>
    <p class="help-link">لديك حساب بالفعل؟ <a href="/login" style="color:var(--gold-500)">سجّل الدخول</a></p>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
