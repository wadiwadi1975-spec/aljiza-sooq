<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><%- include('partials/head', {pageTitle: 'نتائج البحث'}) %></head>
<body>
  <%- include('partials/header') %>
  <div class="container" style="padding:28px 0">
    <form class="search-box" action="/search" method="GET" style="box-shadow:none;border:1px solid var(--line);margin-bottom:22px">
      <input type="text" name="q" value="<%= query.q || '' %>" placeholder="ابحث عن منتج...">
      <select name="category">
        <option value="">كل التصنيفات</option>
        <% categories.forEach(c => { %>
          <option value="<%= c.slug %>" <%= query.category === c.slug ? 'selected' : '' %>><%= c.icon %> <%= c.name %></option>
        <% }) %>
      </select>
      <input type="text" name="city" value="<%= query.city || '' %>" placeholder="المدينة" style="max-width:140px">
      <input type="number" name="priceMin" value="<%= query.priceMin || '' %>" placeholder="السعر من" style="max-width:110px">
      <input type="number" name="priceMax" value="<%= query.priceMax || '' %>" placeholder="السعر إلى" style="max-width:110px">
      <select name="sort">
        <option value="">الأحدث</option>
        <option value="price_asc" <%= query.sort==='price_asc'?'selected':'' %>>السعر: الأقل أولًا</option>
        <option value="price_desc" <%= query.sort==='price_desc'?'selected':'' %>>السعر: الأعلى أولًا</option>
        <option value="featured" <%= query.sort==='featured'?'selected':'' %>>المميز أولًا</option>
      </select>
      <button class="btn btn-gold">بحث</button>
    </form>

    <p style="color:#8a7d67;margin-bottom:14px"><%= results.length %> نتيجة</p>

    <% if (!results.length) { %>
      <div class="empty"><h3>لا توجد نتائج مطابقة</h3><p>جرّب تعديل كلمات البحث أو الفلاتر.</p></div>
    <% } else { %>
    <div class="grid">
      <% results.forEach(p => { %>
        <a class="card" href="/product/<%= p.id %>">
          <div class="card-img">
            <img src="<%= p.image || 'https://placehold.co/400x300?text=AlJeeza+Sooq' %>" alt="<%= p.title %>">
            <% if (p.featured) { %><span class="badge">مميز</span><% } %>
          </div>
          <div class="card-body">
            <p class="card-title"><%= p.title %></p>
            <p class="card-price"><%= p.price ? p.price.toLocaleString('ar-EG') + ' ج.م' : 'السعر عند الطلب' %></p>
            <p class="card-meta"><%= p.storeName %> <% if (p.city) { %> · <%= p.city %><% } %></p>
          </div>
        </a>
      <% }) %>
    </div>
    <% } %>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
