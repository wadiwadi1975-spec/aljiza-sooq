<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">AlJeeza Sooq<small>سوق الجيزة</small></a>
    <nav class="nav-links">
      <a href="/">الرئيسية</a>
      <a href="/search">تصفح المنتجات</a>
      <% if (currentUser) { %>
        <a href="/favorites">المفضلة</a>
        <a href="/messages">الرسائل</a>
      <% } %>
    </nav>
    <div class="header-actions">
      <% if (!currentUser) { %>
        <a href="/login" class="btn btn-outline btn-sm">دخول</a>
        <a href="/register" class="btn btn-gold btn-sm">أضف إعلانك</a>
      <% } else if (currentUser.role === 'admin') { %>
        <a href="/admin" class="btn btn-outline btn-sm">لوحة الإدارة</a>
        <form method="POST" action="/logout" style="display:inline"><button class="btn btn-dark btn-sm">خروج</button></form>
      <% } else if (currentUser.role === 'vendor') { %>
        <a href="/vendor" class="btn btn-outline btn-sm">لوحة العارض</a>
        <form method="POST" action="/logout" style="display:inline"><button class="btn btn-dark btn-sm">خروج</button></form>
      <% } else { %>
        <span style="font-size:14px;color:var(--sand-100)">أهلًا، <%= currentUser.name %></span>
        <form method="POST" action="/logout" style="display:inline"><button class="btn btn-dark btn-sm">خروج</button></form>
      <% } %>
    </div>
  </div>
</header>
