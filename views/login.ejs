<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><%- include('partials/head', {pageTitle: 'تسجيل الدخول'}) %></head>
<body>
  <%- include('partials/header') %>
  <div class="form-page">
    <h1>تسجيل الدخول</h1>
    <% if (error) { %><div class="error-msg"><%= error %></div><% } %>
    <form method="POST" action="/login">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field"><label>البريد الإلكتروني</label><input type="email" name="email" required></div>
      <div class="field"><label>كلمة المرور</label><input type="password" name="password" required></div>
      <button class="btn btn-gold" style="width:100%">دخول</button>
    </form>
    <p class="help-link">ليس لديك حساب؟ <a href="/register" style="color:var(--gold-500)">سجّل الآن</a></p>
    <p style="font-size:12px;color:#8a7d67;margin-top:10px;text-align:center">تجربة: admin@aljeeza.com / Admin@123 — ahmed@example.com / Vendor@123</p>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
