<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><%- include('partials/head', {pageTitle: 'الرسائل'}) %></head>
<body>
  <%- include('partials/header') %>
  <div class="container" style="padding:28px 0;max-width:700px">
    <h1 style="font-size:22px">الرسائل</h1>
    <% if (!threads.length) { %>
      <div class="empty">لا توجد محادثات بعد.</div>
    <% } %>
    <% threads.forEach(t => { %>
      <a class="panel" style="display:flex;justify-content:space-between;align-items:center" href="/messages/<%= t.otherUserId %>">
        <div>
          <strong><%= t.other ? t.other.name : 'مستخدم' %></strong>
          <p style="margin:4px 0 0;color:#8a7d67;font-size:13px"><%= t.lastMsg ? t.lastMsg.body.slice(0,60) : '' %></p>
        </div>
      </a>
    <% }) %>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
