<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><%- include('partials/head') %></head>
<body>
  <%- include('partials/header') %>

  <section class="hero">
    <div class="container hero-content">
      <h1>سوق الجيزة الرقمي — من محلك إلى بيت كل عميل</h1>
      <p>اعرض منتجاتك وخدماتك أمام آلاف المشترين في الجيزة والمحافظات المجاورة، وتواصل معهم مباشرة دون وسيط.</p>
      <form class="search-box" action="/search" method="GET">
        <input type="text" name="q" placeholder="ماذا تبحث عنه؟ سيارات، ذهب، أثاث...">
        <select name="city">
          <option value="">كل المدن</option>
          <option value="الجيزة">الجيزة</option>
          <option value="القاهرة">القاهرة</option>
        </select>
        <button type="submit" class="btn btn-gold">بحث</button>
      </form>
    </div>
  </section>

  <div class="container">
    <div class="cat-strip">
      <% categories.forEach(c => { %>
        <a class="cat-chip" href="/search?category=<%= c.slug %>"><%= c.icon %> <%= c.name %></a>
      <% }) %>
    </div>
  </div>

  <% if (featuredProducts.length) { %>
  <section class="section container">
    <div class="section-head">
      <h2>منتجات مميزة</h2>
      <a href="/search?sort=featured">عرض الكل ←</a>
    </div>
    <div class="grid">
      <% featuredProducts.forEach(p => { %>
        <a class="card" href="/product/<%= p.id %>">
          <div class="card-img">
            <img src="<%= p.image || 'https://placehold.co/400x300?text=AlJeeza+Sooq' %>" alt="<%= p.title %>">
            <span class="badge">مميز</span>
          </div>
          <div class="card-body">
            <p class="card-title"><%= p.title %></p>
            <p class="card-price"><%= p.price ? p.price.toLocaleString('ar-EG') + ' ج.م' : 'السعر عند الطلب' %></p>
            <p class="card-meta"><%= p.storeName %></p>
          </div>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <section class="section container">
    <div class="section-head">
      <h2>أحدث المنتجات</h2>
      <a href="/search">عرض الكل ←</a>
    </div>
    <div class="grid">
      <% latestProducts.forEach(p => { %>
        <a class="card" href="/product/<%= p.id %>">
          <div class="card-img">
            <img src="<%= p.image || 'https://placehold.co/400x300?text=AlJeeza+Sooq' %>" alt="<%= p.title %>">
            <% if (p.featured) { %><span class="badge">مميز</span><% } %>
          </div>
          <div class="card-body">
            <p class="card-title"><%= p.title %></p>
            <p class="card-price"><%= p.price ? p.price.toLocaleString('ar-EG') + ' ج.م' : 'السعر عند الطلب' %></p>
            <p class="card-meta"><%= p.storeName %></p>
          </div>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>متاجر مميزة</h2>
    </div>
    <div class="grid">
      <% featuredStores.forEach(s => { %>
        <a class="store-card" href="/store/<%= s.id %>">
          <img class="store-logo" src="<%= s.logoImage || 'https://placehold.co/100?text=AJS' %>" alt="<%= s.name %>">
          <div>
            <div class="store-name"><%= s.name %></div>
            <div class="stars"><%= s.avgRating ? '★ ' + Number(s.avgRating).toFixed(1) + ' (' + s.reviewCount + ')' : 'لا يوجد تقييم بعد' %></div>
          </div>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="section container">
    <div class="promo">
      <div>
        <h3>أعلن عن منتجك أمام آلاف المشترين</h3>
        <p>سجّل كعارض الآن وابدأ ببناء متجرك الرقمي مجانًا.</p>
      </div>
      <a href="/register" class="btn btn-dark">سجّل كعارض</a>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
