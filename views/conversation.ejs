<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><%- include('partials/head', {pageTitle: other.name}) %></head>
<body>
  <%- include('partials/header') %>
  <div class="container" style="padding:28px 0;max-width:700px">
    <h1 style="font-size:20px">محادثة مع <%= other.name %></h1>
    <div class="panel" style="max-height:420px;overflow-y:auto;display:flex;flex-direction:column">
      <% msgs.forEach(m => { %>
        <div class="msg-bubble <%= m.fromUserId == currentUser.id ? 'msg-me' : 'msg-them' %>"><%= m.body %></div>
      <% }) %>
      <% if (!msgs.length) { %><p class="empty">ابدأ المحادثة الآن</p><% } %>
    </div>
    <form method="POST" action="/messages/<%= other.id %>" style="display:flex;gap:8px;margin-top:14px">
      <input type="text" name="body" placeholder="اكتب رسالتك..." required style="flex:1;padding:12px;border:1px solid var(--line);border-radius:8px">
      <button class="btn btn-gold">إرسال</button>
    </form>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
