<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><%- include('../partials/head', {pageTitle: product ? 'تعديل منتج' : 'إضافة منتج'}) %></head>
<body>
  <%- include('../partials/header') %>
  <div class="container dash-layout">
    <%- include('../partials/vendor-nav') %>
    <div>
      <h1 style="font-size:22px"><%= product ? 'تعديل المنتج' : 'إضافة منتج جديد' %></h1>
      <div class="panel">
        <form method="POST" action="<%= product ? '/vendor/products/'+product.id+'/edit' : '/vendor/products/new' %>" enctype="multipart/form-data">
          <div class="field"><label>اسم المنتج</label><input type="text" name="title" value="<%= product ? product.title : '' %>" required></div>
          <div class="field"><label>الوصف</label><textarea name="description" rows="4"><%= product ? product.description : '' %></textarea></div>
          <div class="field"><label>السعر (جنيه)</label><input type="number" name="price" value="<%= product ? product.price : '' %>"></div>
          <div class="field">
            <label>التصنيف</label>
            <select name="categoryId">
              <% categories.forEach(c => { %>
                <option value="<%= c.id %>" <%= product && product.categoryId===c.id ? 'selected':'' %>><%= c.icon %> <%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label>الموقع</label>
            <select name="locationId">
              <option value="">اختر الموقع</option>
              <% locations.forEach(l => { %>
                <option value="<%= l.id %>" <%= product && product.locationId===l.id ? 'selected':'' %>><%= l.city %> - <%= l.area %></option>
              <% }) %>
            </select>
          </div>
          <% if (product) { %>
          <div class="field">
            <label>الحالة</label>
            <select name="status">
              <option value="active" <%= product.status==='active'?'selected':'' %>>نشط</option>
              <option value="hidden" <%= product.status==='hidden'?'selected':'' %>>مخفي</option>
              <option value="sold" <%= product.status==='sold'?'selected':'' %>>تم البيع</option>
            </select>
          </div>
          <% } %>
          <div class="field">
            <label>صور المنتج (حتى 6 صور)</label>
            <input type="file" name="images" accept="image/*" multiple>
          </div>
          <% if (images.length) { %>
            <div class="gallery-thumbs" style="margin-bottom:14px">
              <% images.forEach(img => { %><img src="<%= img.url %>"><% }) %>
            </div>
          <% } %>
          <button class="btn btn-gold">حفظ المنتج</button>
        </form>
      </div>
    </div>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>
