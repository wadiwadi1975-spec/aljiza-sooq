<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><%- include('../partials/head', {pageTitle: 'الاستفسارات'}) %></head>
<body>
  <%- include('../partials/header') %>
  <div class="container dash-layout">
    <%- include('../partials/vendor-nav') %>
    <div>
      <h1 style="font-size:22px">استفسارات المشترين</h1>
      <div class="panel">
        <table>
          <tr><th>المشتري</th><th>الهاتف</th><th>المنتج</th><th>الرسالة</th><th>التاريخ</th></tr>
          <% inquiries.forEach(i => { %>
            <tr><td><%= i.userName %></td><td><%= i.userPhone||'—' %></td><td><%= i.productTitle %></td><td><%= i.message %></td><td><%= i.createdAt %></td></tr>
          <% }) %>
        </table>
        <% if (!inquiries.length) { %><p class="empty">لا توجد استفسارات بعد.</p><% } %>
      </div>
    </div>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>
