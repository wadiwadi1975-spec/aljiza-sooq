<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><%- include('../partials/head', {pageTitle: 'متجري'}) %></head>
<body>
  <%- include('../partials/header') %>
  <div class="container dash-layout">
    <%- include('../partials/vendor-nav') %>
    <div>
      <h1 style="font-size:22px"><%= store ? 'تعديل بيانات المتجر' : 'إنشاء متجر جديد' %></h1>
      <div class="panel">
        <form method="POST" action="/vendor/store" enctype="multipart/form-data">
          <div class="field"><label>اسم المتجر</label><input type="text" name="name" value="<%= store ? store.name : '' %>" required></div>
          <div class="field"><label>وصف النشاط</label><textarea name="description" rows="3"><%= store ? store.description : '' %></textarea></div>
          <div class="field"><label>صورة الغلاف</label><input type="file" name="cover" accept="image/*"></div>
          <div class="field"><label>شعار المتجر</label><input type="file" name="logo" accept="image/*"></div>
          <div class="field">
            <label>الموقع</label>
            <select name="locationId">
              <option value="">اختر الموقع</option>
              <% locations.forEach(l => { %>
                <option value="<%= l.id %>" <%= store && store.locationId===l.id ? 'selected':'' %>><%= l.city %> - <%= l.area %></option>
              <% }) %>
            </select>
          </div>
          <div class="field"><label>رقم الهاتف</label><input type="text" name="phone" value="<%= store ? store.phone : '' %>"></div>
          <div class="field"><label>رقم واتساب</label><input type="text" name="whatsapp" value="<%= store ? store.whatsapp : '' %>"></div>
          <div class="field"><label>أوقات العمل</label><input type="text" name="workHours" value="<%= store ? store.workHours : '' %>"></div>
          <button class="btn btn-gold">حفظ</button>
        </form>
      </div>
    </div>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>
