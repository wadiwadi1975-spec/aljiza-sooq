<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><%- include('partials/head', {pageTitle: product.title}) %></head>
<body>
  <%- include('partials/header') %>
  <div class="container product-detail">
    <div>
      <div class="gallery-main">
        <img id="mainImg" src="<%= images[0] ? images[0].url : 'https://placehold.co/700x500?text=AlJeeza+Sooq' %>" alt="<%= product.title %>">
      </div>
      <div class="gallery-thumbs">
        <% images.forEach(img => { %>
          <img src="<%= img.url %>" onclick="document.getElementById('mainImg').src='<%= img.url %>'">
        <% }) %>
      </div>

      <div class="panel" style="margin-top:24px">
        <h3>الوصف</h3>
        <p><%= product.description || 'لا يوجد وصف' %></p>
      </div>

      <div class="panel">
        <h3>تقييمات المتجر <% if (avgRating) { %><span class="stars">★ <%= avgRating %></span><% } %></h3>
        <% if (!reviews.length) { %><p style="color:#8a7d67">لا توجد تقييمات بعد.</p><% } %>
        <% reviews.forEach(r => { %>
          <div class="review-item">
            <strong><%= r.userName %></strong> <span class="stars">★ <%= r.rating %></span>
            <p style="margin:4px 0 0"><%= r.comment %></p>
          </div>
        <% }) %>
      </div>
    </div>

    <div>
      <h1 style="font-size:24px;margin:0 0 6px"><%= product.title %></h1>
      <p style="color:#8a7d67;margin:0 0 4px"><%= product.categoryName || '' %> <% if (product.city) { %> · <%= product.city %><% if (product.area) { %>، <%= product.area %><% } %><% } %></p>
      <div class="price-tag"><%= product.price ? product.price.toLocaleString('ar-EG') + ' ج.م' : 'السعر عند الطلب' %></div>

      <a href="/store/<%= product.storeId %>" class="store-card" style="margin-bottom:16px">
        <img class="store-logo" src="<%= product.storeLogo || 'https://placehold.co/100?text=AJS' %>">
        <div>
          <div class="store-name"><%= product.storeName %></div>
          <div style="font-size:13px;color:#8a7d67">عرض المتجر</div>
        </div>
      </a>

      <div class="contact-actions">
        <% if (product.storePhone) { %><a class="btn btn-gold" href="tel:<%= product.storePhone %>">اتصال</a><% } %>
        <% if (product.storeWhatsapp) { %><a class="btn btn-dark" href="https://wa.me/2<%= product.storeWhatsapp %>" target="_blank">واتساب</a><% } %>
        <% if (currentUser) { %>
          <form method="POST" action="/favorite/<%= product.id %>">
            <button class="btn btn-outline"><%= isFavorite ? '★ محفوظ' : '☆ حفظ' %></button>
          </form>
        <% } %>
        <button class="btn btn-outline" onclick="navigator.share ? navigator.share({title: document.title, url: location.href}) : alert(location.href)">مشاركة</button>
      </div>

      <div class="panel">
        <h3>راسل العارض</h3>
        <% if (currentUser) { %>
          <form method="POST" action="/inquiry/<%= product.id %>">
            <div class="field"><textarea name="message" rows="3" placeholder="اكتب استفسارك هنا..." required></textarea></div>
            <button class="btn btn-gold">إرسال الاستفسار</button>
          </form>
        <% } else { %>
          <p>يجب <a href="/login?next=/product/<%= product.id %>" style="color:var(--gold-500)">تسجيل الدخول</a> لإرسال استفسار.</p>
        <% } %>
      </div>

      <% if (currentUser) { %>
      <div class="panel">
        <h3>الإبلاغ عن الإعلان</h3>
        <form method="POST" action="/report">
          <input type="hidden" name="targetType" value="product">
          <input type="hidden" name="targetId" value="<%= product.id %>">
          <input type="hidden" name="back" value="/product/<%= product.id %>">
          <div class="field"><input type="text" name="reason" placeholder="سبب الإبلاغ" required></div>
          <button class="btn btn-outline">إرسال بلاغ</button>
        </form>
      </div>
      <% } %>
    </div>
  </div>

  <% if (similar.length) { %>
  <section class="section container">
    <div class="section-head"><h2>منتجات مشابهة</h2></div>
    <div class="grid">
      <% similar.forEach(p => { %>
        <a class="card" href="/product/<%= p.id %>">
          <div class="card-img"><img src="<%= p.image || 'https://placehold.co/400x300' %>"></div>
          <div class="card-body">
            <p class="card-title"><%= p.title %></p>
            <p class="card-price"><%= p.price ? p.price.toLocaleString('ar-EG') + ' ج.م' : '' %></p>
          </div>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>
  <%- include('partials/footer') %>
</body>
</html>
